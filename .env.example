# ─── Firebase — client-side ───────────────────────────────────────────────────
# EXPO_PUBLIC_ prefix required for Expo to bundle these into the app.
# Get from: Firebase Console → Project Settings → Your apps → digvijay-web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Android SHA-1 Fingerprint (required for Phone Auth on Android)
# Get it: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
# Add the value in Firebase Console → Project Settings → Android app → Add fingerprint
FIREBASE_ANDROID_SHA1=

# ─── Supabase — client-side ───────────────────────────────────────────────────
# Anon key is safe to expose in the app bundle.
# Get from: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase — backend only ──────────────────────────────────────────────────
# NEVER put the service key in the app. Backend .env only.
SUPABASE_SERVICE_KEY=

# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Use these when running the backend on your laptop (emulator or ADB USB).
# After changing, restart with: npx expo start --clear
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
EXPO_PUBLIC_DEV_MOCK_AUTH=true

# ─── PHYSICAL DEVICE TESTING (same WiFi as laptop) ───────────────────────────
# Replace YOUR_LOCAL_IP with your laptop's LAN IP (e.g. 192.168.1.10).
# Run backend with: uvicorn main:app --reload --host 0.0.0.0
# Note: Many home routers block device-to-device traffic (AP isolation).
# Use ADB USB or deploy to Render.com instead if WiFi doesn't work.
# EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000
# EXPO_PUBLIC_WS_URL=ws://YOUR_LOCAL_IP:8000

# ─── PRODUCTION (after Render.com deployment) ────────────────────────────────
# Set these before running: eas build --profile preview  OR  eas build --profile production
# EXPO_PUBLIC_PROD_API_URL and EXPO_PUBLIC_PROD_WS_URL are used when __DEV__ is false.
# EXPO_PUBLIC_API_URL=https://your-app.onrender.com
# EXPO_PUBLIC_PROD_API_URL=https://your-app.onrender.com
# EXPO_PUBLIC_PROD_WS_URL=wss://your-app.onrender.com
# EXPO_PUBLIC_DEV_MOCK_AUTH=false
