# Firebase — client-side (EXPO_PUBLIC_ prefix required for Expo to bundle these)
# Get these from Firebase Console → Project Settings → Your apps → digvijay-web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Android SHA-1 Fingerprint (required for Phone Auth on Android)
# To get it: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
# Add the value in Firebase Console → Project Settings → Your Android app → Add fingerprint
FIREBASE_ANDROID_SHA1=

# Supabase — client-side (anon key is safe to expose in the app)
# Get these from Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — backend only, never put this in the app
SUPABASE_SERVICE_KEY=
