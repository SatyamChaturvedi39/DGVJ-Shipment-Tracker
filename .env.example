# ─── Frontend ─────────────────────────────────────────────────────────────────

# Backend URL — switches automatically based on build type:
#   Dev build (__DEV__ = true)  → EXPO_PUBLIC_API_URL
#   Production APK (__DEV__ = false) → EXPO_PUBLIC_PROD_API_URL
# After changing, restart with: npx expo start --clear

# Local development (emulator or ADB USB)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEV_MOCK_AUTH=true

# Physical device on same Wi-Fi (replace with your laptop's LAN IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# EXPO_PUBLIC_DEV_MOCK_AUTH=false

# Production APK (eas build --profile preview)
# EXPO_PUBLIC_PROD_API_URL=https://your-app.onrender.com
# EXPO_PUBLIC_DEV_MOCK_AUTH=false

# Google Maps — needed for map tiles in production APK (Expo Go works without it)
# Enable "Maps SDK for Android" in Google Cloud Console, restrict to com.digvijayexpress.blr
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenRouteService — free route polyline on customer tracking screen (2000 req/day free)
# Get key at openrouteservice.org → Dashboard → Tokens
EXPO_PUBLIC_ORS_API_KEY=

# ─── Backend (backend/.env only — never put these in the frontend) ─────────────

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET_KEY=
GROQ_API_KEY=
ENVIRONMENT=development
