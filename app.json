{
  "expo": {
    "name": "Digvijay BLR",
    "slug": "digvijay-blr",
    "scheme": "digvijay-blr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C62828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digvijayexpress.blr",
      "config": {
        "googleMapsApiKey": "PLACEHOLDER"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.digvijayexpress.blr",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Digvijay BLR needs your location to track shipment delivery."
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "PLACEHOLDER"
        }
      ]
    ]
  }
}
