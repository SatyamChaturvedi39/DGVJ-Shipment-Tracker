{
  "expo": {
    "name": "Digvijay BLR",
    "slug": "digvijay-blr",
    "scheme": "digvijay-blr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C62828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digvijayexpress.blr",
      "config": {
        "googleMapsApiKey": "PLACEHOLDER"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C62828"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.digvijayexpress.blr",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Digvijay BLR needs your location to track shipment delivery."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ac9ae3a-9997-4bd8-b374-b96569a658c4"
      }
    }
  }
}
